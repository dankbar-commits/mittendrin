# --- App ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Local LLM (any OpenAI-compatible server) ---
# Works with LM Studio, Ollama (its /v1 compat endpoint), vLLM, or anything
# else that implements POST {base_url}/chat/completions the OpenAI way.
#
# LM Studio example:  http://localhost:1234/v1
# Ollama example:     http://localhost:11434/v1   (model e.g. "llama3.1")
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=nvidia/nemotron-3-nano-4b
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_SECONDS=60

# --- Claude fallback ---
# LLM_PRIMARY_PROVIDER: "claude" (default) or "local" — whichever is NOT
# primary becomes the automatic fallback if the primary fails/times out.
# If primary is "claude" but ANTHROPIC_API_KEY is empty, local is used
# directly without even attempting Claude.
LLM_PRIMARY_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Map / location API ---
# MAP_PROVIDER: "osm" (no key needed) or "google" (needs MAPS_API_KEY)
MAP_PROVIDER=osm
MAPS_API_KEY=

# --- Email (SMTP — any provider) ---
# Gmail example: enable 2-Step Verification on your Google account, then
# create an "App Password" (Google Account -> Security -> App Passwords)
# and use that as SMTP_PASSWORD, not your regular Gmail password.
#
# SendGrid example: SMTP_HOST=smtp.sendgrid.net, SMTP_USERNAME=apikey,
# SMTP_PASSWORD=<your SendGrid API key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mittendrin.in